{
  "$schema": "https://schemas.designtokens.org/draft/v1/draft.json",
  "color": {
    "kma": {
      "black":          { "$value": "#1E1E20", "$type": "color", "$description": "Default web background" },
      "white":          { "$value": "#F5F5F5", "$type": "color", "$description": "Default web text on dark" },
      "paper":          { "$value": "#EFEEE7", "$type": "color", "$description": "Warm cream — alternating-section panels (metric, marquee)" },
      "gray-25":        { "$value": "#DFDFE0", "$type": "color" },
      "gray-40":        { "$value": "#BBBCC4", "$type": "color" },
      "gray-60":        { "$value": "#C8CAD0", "$type": "color" },
      "blueberry":      { "$value": "#657FFF", "$type": "color", "$description": "Primary brand color #1" },
      "emerald":        { "$value": "#58D65E", "$type": "color", "$description": "Primary brand color #2 (default --section-color)" },
      "blueberry-dark": { "$value": "#293366", "$type": "color" },
      "emerald-dark":   { "$value": "#245726", "$type": "color" },
      "light-blue":     { "$value": "#66CCFF", "$type": "color" },
      "purple":         { "$value": "#AA80FF", "$type": "color" },
      "pink":           { "$value": "#FF80BF", "$type": "color" },
      "red":            { "$value": "#FF6767", "$type": "color" },
      "orange":         { "$value": "#FFB74D", "$type": "color" },
      "yellow":         { "$value": "#FFEA30", "$type": "color" },
      "violet-app":     { "$value": "#927DFF", "$type": "color", "$description": "Charity / fundraiser / newsroom tag accent" },
      "light-blue-dark":{ "$value": "#336680", "$type": "color" },
      "purple-dark":    { "$value": "#554080", "$type": "color" },
      "pink-dark":      { "$value": "#804060", "$type": "color" },
      "red-dark":       { "$value": "#803333", "$type": "color" },
      "orange-dark":    { "$value": "#805C26", "$type": "color" },
      "yellow-dark":    { "$value": "#807518", "$type": "color" }
    }
  },
  "font": {
    "family": {
      "sans":    { "$value": "book, Arial, Helvetica, sans-serif",  "$type": "fontFamily", "$description": "Stolzl Book (400, 500)" },
      "display": { "$value": "heavy, Arial, Helvetica, sans-serif", "$type": "fontFamily", "$description": "Stolzl Heavy (~900) — all hero/display/CTA" }
    },
    "size": {
      "a1":  { "$value": "{ \"min\": \"64px\", \"max\": \"112px\" }", "$type": "dimension", "$description": "Hero accent (sporadic)" },
      "h1":  { "$value": "{ \"min\": \"40px\", \"max\": \"72px\" }",  "$type": "dimension" },
      "h3":  { "$value": "{ \"min\": \"28px\", \"max\": \"40px\" }",  "$type": "dimension" },
      "b1":  { "$value": "{ \"min\": \"18px\", \"max\": \"24px\" }",  "$type": "dimension" },
      "tag": { "$value": "16px",                                       "$type": "dimension" }
    },
    "line-height": {
      "tight": { "$value": "0.92", "$type": "number" },
      "h1":    { "$value": "1.00", "$type": "number" },
      "snug":  { "$value": "1.20", "$type": "number" },
      "body":  { "$value": "1.40", "$type": "number" }
    }
  },
  "radius": {
    "sharp": { "$value": "1px",   "$type": "dimension", "$description": "Default for UI: buttons, plates, image frames" },
    "pill":  { "$value": "9999px","$type": "dimension", "$description": "Accent words + product tags only" },
    "xs":    { "$value": "8px",   "$type": "dimension" },
    "sm":    { "$value": "16px",  "$type": "dimension" },
    "md":    { "$value": "24px",  "$type": "dimension" },
    "lg":    { "$value": "32px",  "$type": "dimension" },
    "xl":    { "$value": "48px",  "$type": "dimension" },
    "2xl":   { "$value": "64px",  "$type": "dimension" }
  },
  "space": {
    "1":  { "$value": "4px",  "$type": "dimension" },
    "2":  { "$value": "8px",  "$type": "dimension" },
    "3":  { "$value": "12px", "$type": "dimension" },
    "4":  { "$value": "16px", "$type": "dimension" },
    "6":  { "$value": "24px", "$type": "dimension" },
    "8":  { "$value": "32px", "$type": "dimension" },
    "12": { "$value": "48px", "$type": "dimension" },
    "16": { "$value": "64px", "$type": "dimension" },
    "24": { "$value": "96px", "$type": "dimension" }
  },
  "grid": {
    "margin": { "$value": "2.22rem", "$type": "dimension" },
    "gutter": { "$value": "0.56rem", "$type": "dimension" },
    "nav-h":  { "$value": "3.89rem", "$type": "dimension" }
  },
  "motion": {
    "ease":            { "$value": "cubic-bezier(0.85, 0, 0.15, 1)", "$type": "cubicBezier", "$description": "Default: decisive ease-in-out" },
    "ease-out-quart":  { "$value": "cubic-bezier(0.16, 1, 0.30, 1)", "$type": "cubicBezier", "$description": "Organic: hero reveals" },
    "duration-fast":   { "$value": "300ms",  "$type": "duration" },
    "duration-mid":    { "$value": "600ms",  "$type": "duration" },
    "duration-slow":   { "$value": "1200ms", "$type": "duration" },
    "duration-hero":   { "$value": "2000ms", "$type": "duration" }
  }
}
